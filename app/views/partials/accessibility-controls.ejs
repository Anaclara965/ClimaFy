<div class="accessibility-controls" role="group" aria-label="Opções de acessibilidade">
  <button
    type="button"
    class="accessibility-trigger"
    aria-label="Abrir painel de acessibilidade"
    aria-expanded="false"
    aria-controls="accessibility-panel"
  >
    <i class="ph ph-wheelchair" aria-hidden="true"></i>
  </button>

  <div
    class="accessibility-panel"
    id="accessibility-panel"
    role="group"
    aria-label="Opções de acessibilidade"
    hidden
  >
    <div class="accessibility-font-controls" role="group" aria-label="Tamanho da fonte">
      <button
        type="button"
        class="accessibility-button"
        data-accessibility-action="decrease-font"
        aria-label="Diminuir tamanho da fonte"
        title="Diminuir fonte"
      >
        <span aria-hidden="true">A−</span>
      </button>
      <button
        type="button"
        class="accessibility-button"
        data-accessibility-action="reset-font"
        aria-label="Restaurar tamanho e opções de acessibilidade"
        title="Restaurar acessibilidade"
      >
        <span aria-hidden="true">↺</span>
      </button>
      <button
        type="button"
        class="accessibility-button"
        data-accessibility-action="increase-font"
        aria-label="Aumentar tamanho da fonte"
        title="Aumentar fonte"
      >
        <span aria-hidden="true">A+</span>
      </button>
    </div>

    <button
      type="button"
      class="accessibility-button accessibility-toggle"
      data-accessibility-action="toggle-contrast"
      aria-pressed="false"
      aria-label="Ativar alto contraste"
      title="Alto contraste"
    >
      <span aria-hidden="true" class="contrast-icon"></span>
      <span class="accessibility-option-label">Contraste</span>
    </button>
    <button
      type="button"
      class="accessibility-button accessibility-toggle"
      data-accessibility-action="toggle-links"
      aria-pressed="false"
      aria-label="Destacar links"
      title="Destacar links"
    >
      <span aria-hidden="true"><u>Link</u></span>
      <span class="accessibility-option-label">Links</span>
    </button>
    <button
      type="button"
      class="accessibility-button accessibility-toggle"
      data-accessibility-action="toggle-motion"
      aria-pressed="false"
      aria-label="Reduzir animações"
      title="Reduzir animações"
    >
      <span aria-hidden="true">II</span>
      <span class="accessibility-option-label">Animações</span>
    </button>
  </div>
</div>
<script src="/js/accessibility.js" defer></script>
