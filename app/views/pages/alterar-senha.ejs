<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClimaFy - Alterar senha</title>
    <link rel="stylesheet" href="/css/login.css" />
    <link rel="stylesheet" href="/css/header.css?v=3" />
    <link rel="stylesheet" href="/css/footer.css?v=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
  </head>
  <body>
    <%- include('../partials/header') %>
    <main class="content-wrapper">
      <section class="login-section recovery-section">
        <article class="login-container">
          <header class="form-header">
            <h2>Alterar senha</h2>
            <p>Confirme sua senha atual e escolha uma nova senha para sua conta.</p>
          </header>
          <% if (aviso) { %><p class="login-alert is-success" role="status"><%= aviso %></p><% } %>
          <% if (erros && erros.length) { %>
          <ul class="login-erros" role="alert"><% erros.forEach((mensagem) => { %><li><%= mensagem %></li><% }); %></ul>
          <% } %>
          <form id="change-password-form" action="/alterar-senha" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfConta %>" />
            <fieldset class="input-group">
              <label for="current-password">Senha atual</label>
              <input type="password" id="current-password" name="senhaAtual" autocomplete="current-password" required />
            </fieldset>
            <fieldset class="input-group">
              <label for="new-password">Nova senha</label>
              <input type="password" id="new-password" name="novaSenha" autocomplete="new-password" minlength="8" required aria-describedby="new-password-help" />
              <small id="new-password-help">Use no mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.</small>
            </fieldset>
            <fieldset class="input-group">
              <label for="confirm-password">Confirmar nova senha</label>
              <input type="password" id="confirm-password" name="confirmaNovaSenha" autocomplete="new-password" minlength="8" required />
            </fieldset>
            <button type="submit" class="btn-submit">Continuar</button>
          </form>
          <p class="login-footer"><a href="/alterar-perfil">Voltar para o perfil</a></p>
          <section class="security-badge"><i class="ph-fill ph-lock-key"></i><span>Sua senha é armazenada com hash seguro.</span></section>
        </article>
      </section>
      <section class="hero-section recovery-hero">
        <article class="hero-content">
          <header class="hero-header">
            <span class="hero-logo-icon" aria-hidden="true">+</span>
            <h1>ClimaFy</h1>
            <h2>Juntos pela segurança<br />da sua cidade</h2>
          </header>
          <p class="hero-description">Mantenha sua conta protegida para seguir acompanhando as mudanças do seu bairro.</p>
        </article>
        <section class="stats-section">
          <article class="stat-item"><strong>1.247</strong><span>Relatos Ativos</span></article>
          <span class="stat-divider"></span>
          <article class="stat-item"><strong>48</strong><span>Bairros</span></article>
          <span class="stat-divider"></span>
          <article class="stat-item"><strong>12</strong><span>Cidades</span></article>
        </section>
      </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/alterar-senha.js" defer></script>
  </body>
</html>
