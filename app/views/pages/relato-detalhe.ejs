<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClimaFy - <%= relato.titulo %></title>
  <link rel="stylesheet" href="/css/relatos.css" />
  <link rel="stylesheet" href="/css/header.css?v=2" /><link rel="stylesheet" href="/css/footer.css?v=1" />
  <link rel="stylesheet" href="/css/relato-detalhe.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
</head>
<body>
  <%- include('../partials/header') %>
  <% const rotulos = {aberto: 'Aberto', em_andamento: 'Em andamento', resolvido: 'Resolvido', pendente: 'Aguardando moderação', aprovado: 'Aprovado', rejeitado: 'Rejeitado', solicitado_ajuste: 'Ajuste solicitado'}; %>
  <main class="report-detail" data-public-id="<%= relato.publicId %>" data-versao="<%= relato.versao %>" data-csrf="<%= csrfToken %>">
    <article aria-labelledby="detail-title">
      <header><p><%= relato.categoria %> · <%= relato.bairro %> — <%= relato.cidade %></p><h1 id="detail-title"><%= relato.titulo %></h1></header>
      <p class="detail-description"><%= relato.descricao %></p>
      <dl>
        <section><dt>Situação</dt><dd id="detail-status"><%= rotulos[relato.status] %></dd></section>
        <section><dt>Severidade</dt><dd><%= relato.severidade %></dd></section>
        <section><dt>Enviado em</dt><dd><time datetime="<%= new Date(relato.criadoEm).toISOString() %>"><%= new Date(relato.criadoEm).toLocaleString('pt-BR', {timeZone: 'America/Sao_Paulo'}) %></time></dd></section>
        <section><dt>Votos</dt><dd><%= relato.votos %></dd></section>
        <% if (relato.moderacao) { %>
          <section><dt>Moderação</dt><dd><%= rotulos[relato.moderacao] %></dd></section>
          <% if (relato.motivo) { %><section><dt>Motivo</dt><dd><%= relato.motivo %></dd></section><% } %>
          <% if (relato.observacao) { %><section><dt>Observação da revisão</dt><dd><%= relato.observacao %></dd></section><% } %>
        <% } %>
      </dl>
      <% if (relato.referencia) { %><p>Referência: <%= relato.referencia %></p><% } %>
      <section id="detail-media" aria-labelledby="detail-media-title" data-midias-url="<%= (modo === 'moderador' ? '/api/adm/relatos/' : modo === 'autor' ? '/api/meus-relatos/' : '/api/relatos/') + relato.publicId + '/midias' %>">
        <h2 id="detail-media-title">Fotos e vídeos</h2>
        <p data-midia-feedback role="status">Carregando anexos…</p>
        <section data-midia-lista aria-label="Anexos do relato"></section>
      </section>
      <section id="detail-map" data-latitude="<%= relato.latitude %>" data-longitude="<%= relato.longitude %>" aria-label="Localização do relato"></section>
      <p><a href="https://www.openstreetmap.org/?mlat=<%= relato.latitude %>&amp;mlon=<%= relato.longitude %>#map=17/<%= relato.latitude %>/<%= relato.longitude %>" target="_blank" rel="noopener noreferrer">Abrir localização no OpenStreetMap</a></p>
    </article>
    <% if (modo === 'autor') { %>
      <nav aria-label="Ações do seu relato">
        <a href="/meus-relatos/<%= relato.publicId %>/editar">Editar relato</a>
        <button type="button" id="delete-report">Excluir relato</button>
      </nav>
      <p id="author-feedback" role="status"></p>
    <% } %>
    <% if (modo === 'moderador') { %>
      <section aria-labelledby="situation-title">
        <h2 id="situation-title">Atualizar situação do problema</h2>
        <p>Esta ação não aprova nem rejeita a publicação.</p>
        <form id="situation-form" data-current-status="<%= relato.status %>">
          <label for="situation">Situação</label>
          <select id="situation" required>
            <% for (const status of ['aberto','em_andamento','resolvido']) { %>
              <option value="<%= status %>" <%= status === relato.status ? 'selected' : '' %>><%= rotulos[status] %></option>
            <% } %>
          </select>
          <label for="situation-note">Observação (opcional)</label>
          <textarea id="situation-note" maxlength="255"></textarea>
          <button type="submit">Salvar situação</button>
        </form>
        <p id="situation-feedback" role="status"></p>
      </section>
    <% } %>
    <nav aria-label="Navegação do relato"><a href="<%= modo === 'moderador' ? '/adm/moderacao' : modo === 'autor' ? '/meus-relatos' : '/relatos' %>">← Voltar à lista</a></nav>
  </main>
  <%- include('../partials/footer') %>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="/js/relato-ui.js"></script><script src="/js/relato-midias.js"></script><script src="/js/relato-detalhe.js"></script>
</body>
</html>
