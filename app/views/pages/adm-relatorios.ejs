<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClimaFy - Relatórios Administrativos</title>
    <link rel="stylesheet" href="/css/adm-areas.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-admin-page="relatorios">
    <section class="admin-shell">
        <aside class="sidebar" aria-label="Menu administrativo">
            <header class="sidebar-brand">
                <span class="brand-mark" aria-hidden="true">+</span>
                <strong>ClimaFy</strong>
                <span class="admin-badge"><%= usuario.papel === 'administrador' ? 'ADMIN' : 'MODERADOR' %></span>
            </header>
            <nav class="sidebar-nav" aria-label="Navegação do painel">
                <a href="/adm"><span>Dashboard</span></a>
                <a href="/adm/moderacao"><span>Moderação</span></a>
                <a href="/adm/relatos"><span>Todos os Relatos</span></a>
                <a href="/adm/usuarios"><span>Usuários</span></a>
                <a href="/adm/investimentos"><span>Investimentos</span></a>
                <a class="active" href="/adm/relatorios" aria-current="page"><span>Relatórios</span></a>
            </nav>
            <footer class="sidebar-user">
                <strong><%= usuario.nome %></strong>
                <span><%= usuario.email %></span>
                <a href="/logout">← Sair do painel</a>
            </footer>
        </aside>

      <main class="admin-main">
        <header class="admin-header">
          <section>
            <h1>Relatórios</h1>
            <p>
              Gere análises consolidadas para acompanhamento e prestação de
              contas
            </p>
          </section>
          <menu class="header-actions" aria-label="Ações administrativas">
            <li>
              <button
                class="icon-button"
                type="button"
                aria-label="Notificações"
                disabled title="Notificações ainda não conectadas neste painel"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path></svg
                ><span>—</span>
              </button>
            </li>
            <li>
              <button
                class="avatar-button"
                type="button"
                aria-label="Perfil administrador"
                disabled title="Gerenciamento de perfil em alinhamento com o frontend"
              >
                <%= (usuario.nome || 'A').charAt(0).toUpperCase() %>
              </button>
            </li>
          </menu>
        </header>

        <section class="admin-area-content">
          <section class="area-summary" aria-label="Resumo dos relatórios">
            <article class="summary-card">
              <span>Relatórios disponíveis</span><strong>1</strong
              ><small>Relatos por região em CSV</small>
            </article>
            <article class="summary-card" style="--card-color: #147a43">
              <span>Última geração nesta página</span><strong>CSV</strong
              ><small id="export-last-time">Nenhum arquivo solicitado</small>
            </article>
            <article class="summary-card" style="--card-color: #2469d6">
              <span>Período padrão</span><strong>30 dias</strong
              ><small>Personalizável na exportação</small>
            </article>
            <article class="summary-card" style="--card-color: #f4b60d">
              <span>Limite por arquivo</span><strong>5.000</strong
              ><small>Use filtros para consultas maiores</small>
            </article>
          </section>

          <section class="reports-grid" aria-label="Relatórios disponíveis">
            <article class="report-card">
              <section>
                <span
                  class="report-card-icon"
                  style="--icon-bg: #e0efff; --icon-color: #2469d6"
                  >RG</span
                >
                <h2>Relatos por região</h2>
                <p>
                  Uma linha por relato, com região, categoria, situação e moderação atual.
                  Sem dados cadastrais do autor, textos livres ou localização exata.
                </p>
                <form id="report-export-form" action="/api/adm/relatorios/relatos.csv" method="GET" aria-describedby="export-feedback">
                  <section>
                    <label for="export-period">Período de criação</label>
                    <select id="export-period" name="dias" class="area-select" disabled>
                      <option value="7">Últimos 7 dias</option>
                      <option value="30" selected>Últimos 30 dias</option>
                      <option value="90">Últimos 90 dias</option>
                      <option value="365">Últimos 365 dias</option>
                      <option value="todos">Todo o histórico</option>
                    </select>
                  </section>
                  <section>
                    <label for="export-category">Categoria</label>
                    <select id="export-category" name="categoria" class="area-select" disabled><option value="">Todas as categorias</option></select>
                  </section>
                  <section>
                    <label for="export-neighborhood">Bairro e cidade</label>
                    <select id="export-neighborhood" name="bairro" class="area-select" disabled><option value="">Todos os bairros</option></select>
                  </section>
                  <section>
                    <label for="export-status">Situação do problema</label>
                    <select id="export-status" name="status" class="area-select" disabled>
                      <option value="">Todas as situações</option>
                      <option value="aberto">Aberto</option>
                      <option value="em_andamento">Em andamento</option>
                      <option value="resolvido">Resolvido</option>
                    </select>
                  </section>
                </form>
                <p id="export-feedback" role="status" aria-live="polite"></p>
                <noscript><p>Ative o JavaScript para carregar os filtros e solicitar o CSV.</p></noscript>
              </section>
              <footer>
                <span>Consulta no momento da geração</span
                ><button
                  type="submit" form="report-export-form" id="export-reports" disabled
                >
                  Baixar CSV
                </button>
              </footer>
            </article>
            <article class="report-card">
              <section>
                <span
                  class="report-card-icon"
                  style="--icon-bg: #e0f5e9; --icon-color: #147a43"
                  >MD</span
                >
                <h2>Desempenho da moderação</h2>
                <p>
                  Tempo médio de análise, aprovações, rejeições e produtividade
                  da equipe.
                </p>
              </section>
              <footer>
                <span>Ainda não implementado</span
                ><button
                  type="button"
                  disabled title="Este relatório será conectado em outra etapa"
                >
                  Gerar relatório
                </button>
              </footer>
            </article>
            <article class="report-card">
              <section>
                <span
                  class="report-card-icon"
                  style="--icon-bg: #fff6d6; --icon-color: #8a6500"
                  >$</span
                >
                <h2>Execução de investimentos</h2>
                <p>
                  Recursos planejados, comprometidos e executados por projeto e
                  território.
                </p>
              </section>
              <footer>
                <span>Ainda não implementado</span
                ><button
                  type="button"
                  disabled title="Depende da integração de investimentos"
                >
                  Gerar relatório
                </button>
              </footer>
            </article>
            <article class="report-card">
              <section>
                <span
                  class="report-card-icon"
                  style="--icon-bg: #f3e8ff; --icon-color: #7d3ec7"
                  >US</span
                >
                <h2>Engajamento de usuários</h2>
                <p>
                  Cadastros, atividade, recorrência e participação da comunidade
                  na plataforma.
                </p>
              </section>
              <footer>
                <span>Ainda não implementado</span
                ><button
                  type="button"
                  disabled title="Este relatório será conectado em outra etapa"
                >
                  Gerar relatório
                </button>
              </footer>
            </article>
            <article class="report-card">
              <section>
                <span
                  class="report-card-icon"
                  style="--icon-bg: #ffe8d8; --icon-color: #d96516"
                  >EC</span
                >
                <h2>Eventos climáticos</h2>
                <p>
                  Consolidação das ocorrências por tipo, severidade, duração e
                  áreas afetadas.
                </p>
              </section>
              <footer>
                <span>Ainda não implementado</span
                ><button
                  type="button"
                  disabled title="Este relatório será conectado em outra etapa"
                >
                  Gerar relatório
                </button>
              </footer>
            </article>
            <article class="report-card">
              <section>
                <span
                  class="report-card-icon"
                  style="--icon-bg: #ffe0e0; --icon-color: #d62727"
                  >!</span
                >
                <h2>Áreas de risco</h2>
                <p>
                  Priorização de territórios críticos baseada em ocorrências e
                  investimentos.
                </p>
              </section>
              <footer>
                <span>Ainda não implementado</span
                ><button
                  type="button"
                  disabled title="Depende das integrações de ocorrências e investimentos"
                >
                  Gerar relatório
                </button>
              </footer>
            </article>
          </section>
        </section>
      </main>
    </section>
    <script src="/js/adm-relatorios.js"></script>
  </body>
</html>
