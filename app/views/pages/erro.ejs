<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClimaFy - <%= titulo %></title>
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/erro.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/header.css?v=2" />
    <link rel="stylesheet" href="/css/footer.css?v=1" />
  </head>
  <body>
    <%- include('../partials/header') %>

    <main class="error-page">
      <p class="error-code"><%= status %></p>
      <h1><%= titulo %></h1>
      <p class="error-message"><%= mensagem %></p>
      <nav class="error-actions" aria-label="Ações disponíveis">
        <a class="error-primary" href="/">Voltar ao início</a>
        <a class="error-secondary" href="/relatos">Ver relatos</a>
      </nav>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
