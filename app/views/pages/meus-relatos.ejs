<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClimaFy - Meus relatos</title>
  <link rel="stylesheet" href="/css/relatos.css" />
  <link rel="stylesheet" href="/css/header.css?v=2" /><link rel="stylesheet" href="/css/footer.css?v=1" />
</head>
<body>
  <%- include('../partials/header') %>
  <main>
    <header class="reports-hero"><h1>Meus relatos</h1><p>Acompanhe a revisão dos relatos que você enviou.</p></header>
    <section class="cards-section" aria-label="Seus relatos">
      <p id="my-feedback" role="status"></p><button type="button" id="reload-my-reports">Atualizar</button>
      <p><a href="/new-report">Registrar novo relato</a></p>
      <section class="reports-grid" id="my-reports"></section>
      <nav class="pagination" id="my-pagination" aria-label="Páginas dos seus relatos"></nav>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/relato-ui.js"></script><script src="/js/meus-relatos.js"></script>
</body>
</html>
